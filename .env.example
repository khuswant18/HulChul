# Optional. Without a key the operator runs in rules-only mode (no LLM).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# auto (use Groq when a key is set) | groq | off
OPERATOR_LLM=auto
# Must support strict JSON-schema output on Groq: openai/gpt-oss-120b or openai/gpt-oss-20b
OPERATOR_MODEL=openai/gpt-oss-120b

# Sandbox apps (the test environment the operator works in)
KAAMKAAJ_URL=http://localhost:4010
POSTBOX_URL=http://localhost:4020
# Every synthetic sandbox account uses this password. Not a real credential.
SANDBOX_PASSWORD=demo-pass-2026

OPERATOR_PORT=4100
NEXT_PUBLIC_OPERATOR_URL=http://localhost:4100

# Browser behaviour
HEADLESS=false
SLOW_MO_MS=120
